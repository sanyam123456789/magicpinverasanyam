# Copy this file to `.env` and fill in the values yourself.
# NEVER commit `.env` and NEVER paste real keys into chat or the README.

# LLM provider: OpenCode Zen (https://opencode.ai/zen). Sole provider in this build; when it is slow,
# unavailable or rejects the key, the bot uses its deterministic local fallback (fallback.py), never a
# second LLM provider (none is configured).
OPENCODE_API_KEY=
# Model id as OpenCode Zen lists it (no "opencode/" prefix, this is the Chat Completions API, not Responses).
# deepseek-v4.1-flash is the only model verified this session to answer reliably over Chat Completions.
OPENCODE_MODEL=deepseek-v4.1-flash

# Served by GET /v1/metadata (must be filled in before submission)
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
# Set this to the submission time (ISO 8601, e.g. 2026-09-27T14:30:00Z) when you submit
SUBMITTED_AT=
